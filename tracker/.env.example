# Copy this file to tracker/.env and fill in your own values.
# tracker/.env is ignored by git: your keys never leave your computer.

# --- Model (one is enough; with provider: auto the first one set is used) ---
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key (backup option): https://console.groq.com/keys
GROQ_API_KEY=

# --- Web search ---
# Free Tavily key (1,000 credits a month): https://app.tavily.com
TAVILY_API_KEY=

# --- Your CrowdCampaign backend (the tracker saves its memory there) ---
CROWDCAMPAIGN_API_URL=http://localhost:4000
# The app account the tracker logs in as. Its runs show up when you log in as this user.
# These are the course's public grader credentials, not a personal secret.
TRACKER_USERNAME=NYUgrader
TRACKER_PASSWORD=Courant2026!
