# Every variable the backend reads, with example values.
#
#   .env        committed; throwaway database URL + non-secret settings only
#   .env.local  git-ignored; your personal keys (loaded first, so it wins)

# PostgreSQL connection string (Neon, Supabase, Render or local Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Port the API listens on. If you change it, change VITE_API_URL in frontend/.env too.
PORT=4000

# Browser origins allowed to call the API (CORS), comma-separated, no spaces needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# How long a login token stays valid, in seconds (7200 = 2 hours).
TOKEN_TTL_SECONDS=7200

# Optional. Key used to sign login tokens; at least 32 characters.
# Leave it unset locally: the server creates one on first start and keeps it in
# backend/.secrets/jwt-secret (git-ignored). Set it when you deploy.
# JWT_SECRET=

# AI judge (optional; the whole app works without it).
#   auto      Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
#             else the offline estimate (clearly labelled "not AI" in the app)
#   anthropic | gemini | offline   force one of them
AI_PROVIDER=auto

# Put real keys in backend/.env.local, never in .env.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Seconds to wait for one AI request before giving up (default 45).
# AI_TIMEOUT_SECONDS=45
